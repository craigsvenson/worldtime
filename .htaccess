# This directory holds standalone web tools (timezone.php, timezone_map.php)
# that ARE meant to be requested directly -- unlike src/ or cron/, this is
# not a blanket "deny all" directory. Same site-wide convention as
# tickermetrix.com/.htaccess and hud_metrics/.htaccess: block any
# .ini/.csv/.txt that might ever land here (config/data files, never meant
# to be served as plain text), while leaving .php/.svg (the actual pages
# and worldmap.svg) fully accessible.
<FilesMatch "\.(ini|csv|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
